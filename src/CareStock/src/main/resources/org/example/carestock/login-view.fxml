<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.carestock.controller.LoginController"
      stylesheets="@login.css"
      styleClass="login-root"
      prefWidth="1100"
      prefHeight="650">

    <children>
        <!-- Panel izquierdo -->
        <VBox prefWidth="390" minWidth="300"
              alignment="CENTER_LEFT"
              spacing="20"
              styleClass="login-side"
              style="-fx-padding: 52;">

            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <StackPane minWidth="46" minHeight="46"
                                   maxWidth="46" maxHeight="46">
                            <children>
                                <Circle radius="23" fill="#EDE7F7"/>
                                <Rectangle width="7" height="24"
                                           arcWidth="3" arcHeight="3"
                                           fill="#8062BF"/>
                                <Rectangle width="24" height="7"
                                           arcWidth="3" arcHeight="3"
                                           fill="#8062BF"/>
                            </children>
                        </StackPane>

                        <VBox alignment="CENTER_LEFT" spacing="2">
                            <children>
                                <Label text="CareStock"
                                       styleClass="login-heading">
                                    <font>
                                        <Font name="System Bold" size="23"/>
                                    </font>
                                </Label>
                                <Label text="Gestión farmacéutica integral"
                                       styleClass="login-side-description"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label text="Control de inventario,&#10;lotes y vencimientos&#10;en un solo lugar."
                       wrapText="true"
                       styleClass="login-heading">
                    <font>
                        <Font name="System Bold" size="23"/>
                    </font>
                </Label>

                <Label text="Trazabilidad en tiempo real y farmacovigilancia integrada."
                       wrapText="true"
                       styleClass="login-side-description">
                    <font>
                        <Font size="13"/>
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- Panel de autenticación -->
        <StackPane HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #FDFBF7;">

            <padding>
                <Insets top="32" right="36" bottom="32" left="36"/>
            </padding>

            <children>
                <VBox alignment="CENTER_LEFT"
                      maxWidth="440"
                      spacing="14"
                      styleClass="login-card">

                    <children>
                        <!-- Identidad de marca -->
                        <HBox alignment="CENTER_LEFT" spacing="13">
                            <children>
                                <StackPane minWidth="46" minHeight="46"
                                           maxWidth="46" maxHeight="46">
                                    <children>
                                        <Circle radius="23" fill="#EDE7F7"/>
                                        <Rectangle width="7" height="24"
                                                   arcWidth="3" arcHeight="3"
                                                   fill="#8062BF"/>
                                        <Rectangle width="24" height="7"
                                                   arcWidth="3" arcHeight="3"
                                                   fill="#8062BF"/>
                                    </children>
                                </StackPane>

                                <VBox alignment="CENTER_LEFT" spacing="3">
                                    <children>
                                        <Label text="CareStock"
                                               styleClass="login-heading">
                                            <font>
                                                <Font name="System Bold"
                                                      size="26"/>
                                            </font>
                                        </Label>

                                        <Label text="Gestión farmacéutica integral"
                                               styleClass="login-muted">
                                            <font>
                                                <Font size="12"/>
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Label text="Inicia sesión para gestionar el inventario de tu farmacia."
                               wrapText="true"
                               styleClass="login-muted">
                            <font>
                                <Font size="13"/>
                            </font>
                        </Label>

                        <!-- Correo -->
                        <VBox spacing="5">
                            <children>
                                <Label text="Correo institucional"
                                       styleClass="login-heading"/>

                                <TextField fx:id="txtEmail"
                                           promptText="usuario@dominio.com"
                                           onAction="#onEmailAction"
                                           prefHeight="44"
                                           styleClass="login-input"/>

                                <Label fx:id="lblEmailError"
                                       styleClass="login-error"
                                       visible="false"
                                       managed="false"
                                       wrapText="true"/>
                            </children>
                        </VBox>

                        <!-- Contraseña con visibilidad -->
                        <VBox spacing="5">
                            <children>
                                <Label text="Contraseña"
                                       styleClass="login-heading"/>

                                <StackPane>
                                    <children>
                                        <PasswordField fx:id="txtPassword"
                                                       promptText="Contraseña"
                                                       onAction="#onPasswordAction"
                                                       prefHeight="44"
                                                       styleClass="login-input"
                                                       style="-fx-padding: 0 45 0 12;"/>

                                        <TextField fx:id="txtPasswordVisible"
                                                   promptText="Contraseña"
                                                   onAction="#onPasswordAction"
                                                   prefHeight="44"
                                                   styleClass="login-input"
                                                   style="-fx-padding: 0 45 0 12;"
                                                   visible="false"
                                                   managed="false"/>

                                        <Button fx:id="btnMostrarPassword"
                                                onAction="#onTogglePassword"
                                                text="👁"
                                                styleClass="login-eye"
                                                StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="5"/>
                                            </StackPane.margin>
                                        </Button>
                                    </children>
                                </StackPane>

                                <Label fx:id="lblPasswordError"
                                       styleClass="login-error"
                                       visible="false"
                                       managed="false"
                                       wrapText="true"/>
                            </children>
                        </VBox>

                        <CheckBox fx:id="chkRecordarme"
                                  text="Recordar mi correo"
                                  styleClass="login-muted"/>

                        <!-- Ingreso -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Button fx:id="btnIngresar"
                                        text="Iniciar sesión"
                                        onAction="#onIngresar"
                                        defaultButton="true"
                                        prefHeight="46"
                                        maxWidth="1.7976931348623157E308"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="login-action"/>

                                <ProgressIndicator fx:id="loaderCarga"
                                                   prefWidth="25"
                                                   prefHeight="25"
                                                   visible="false"
                                                   managed="false"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblNotificacion"
                               styleClass="login-notification"
                               visible="false"
                               managed="false"
                               wrapText="true"
                               maxWidth="1.7976931348623157E308"/>

                        <Separator>
                            <VBox.margin>
                                <Insets top="10" bottom="10"/>
                            </VBox.margin>
                        </Separator>

                        <Label text="Acceso exclusivo para personal autorizado de farmacia y regentes IPS."
                               wrapText="true"
                               styleClass="login-muted">
                            <font>
                                <Font size="11"/>
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>
