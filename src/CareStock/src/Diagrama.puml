' ============================================================
' 9. FACHADA / PATRON GOF FACADE
' ============================================================
package "facade" {
    class Inventario <<Facade>> {
- idUsuario: int

- aseoDAO: AseoDAO

- maternidadDAO: MaternidadDAO

- medicamentoDAO: MedicamentoDAO

- medicamentoCatalogoDAO: MedicamentoCatalogoDAO

- loteDAO: LoteDAO

- consulta: ConsultaInventario

- registroLoteService: RegistroLoteService

- farmacovigilanciaService: FarmacovigilanciaService


        + Inventario(usuario: Usuario)
- farmaciaActual(): int

        + registrarMedicamento(producto: Medicamento): Medicamento
        + listarMedicamentos(): List<RegistroCatalogo>
        + actualizarMedicamento(id: int, producto: Medicamento): boolean
        + desactivarMedicamento(id: int): boolean
        + registrarAseo(producto: Aseo): int
        + buscarAseo(id: int): RegistroCatalogo
        + listarAseo(): List<RegistroCatalogo>
        + actualizarAseo(id: int, producto: Aseo): boolean
        + desactivarAseo(id: int): boolean
        + registrarMaternidad(producto: Maternidad): int
        + buscarMaternidad(id: int): RegistroCatalogo
        + listarMaternidad(): List<RegistroCatalogo>
        + actualizarMaternidad(id: int, producto: Maternidad): boolean
        + desactivarMaternidad(id: int): boolean
        + listarLotes(): List<Lote>
        + registrarLote(lote: Lote): Lote
        + dispensarMedicamento(idLote: int, cantidad: int): void
