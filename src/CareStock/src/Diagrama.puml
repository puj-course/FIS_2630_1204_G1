' ============================================================
' 10. DTO / CONSULTA UNIFICADA Y VISTAS
' ============================================================
package "dto" {
    class RegistroCatalogo <<record>> {
        + id: int
        + producto: Object
        + estado: String
    }

    class ProductoInventario <<record>> {
        + id: int
        + categoria: String
        + codigo: String
        + nombre: String
        + presentacion: String
        + existencia: int
        + estado: String
    }

    class FiltroProductoInventario <<utility>> {
        + {static} coincide(producto: ProductoInventario, categoria: String, busqueda: String): boolean
    }

    class DatosCatalogo <<record>> {
        + productos: List<RegistroCatalogo>
        + categoriasMedicamento: Map<Integer, String>
        + creadoNanos: long
    }

    class DatosLotes <<record>> {
        + lotes: List<Lote>
        + categoriaPorMedicamento: Map<Integer, String>
        + categorias: Map<Integer, String>
        + conteoTipos: Map<String, Integer>
    }
}

' ============================================================
' 11. PROXY Y CACHE MULTIFARMACIA
' ============================================================
package "proxy" {

    interface ConsultaInventario <<Subject>> {
        + listarPorFarmacia(idFarmacia: int): List<ProductoInventario>
    }

    class ConsultaInventarioProxy <<Proxy>> {
- real: ConsultaInventario

- ttlNanos: long

- cache: LinkedHashMap<Integer, Entrada>

- pendientes: Map<Integer, Carga>

- aciertos: AtomicLong

- consultas: AtomicLong


        + ConsultaInventarioProxy(real: ConsultaInventario, ttl: Duration)
        + listarPorFarmacia(idFarmacia: int): List<ProductoInventario>
        + invalidarFarmacia(idFarmacia: int): void
        + invalidar(): void
        + aciertos(): long
        + consultasReales(): long
    }

    class "ConsultaInventarioProxy.Entrada" as ProxyEntrada <<record interno>> {
        + datos: List<ProductoInventario>
        + creadaNanos: long
    }

    class "ConsultaInventarioProxy.Carga" as ProxyCarga <<auxiliar interno>> {
        + futuro: CompletableFuture<List<ProductoInventario>>
    }

    class InventarioConsultas <<factory / singleton>> {
- {static} PROXY: ConsultaInventarioProxy


        + {static} compartida(): ConsultaInventarioProxy
        + {static} invalidarFarmacia(idFarmacia: int): void
        + {static} invalidar(): void
    }

    class CacheFarmacia <<cache TTL/LRU>> {
- cache: LinkedHashMap<Integer, Object>

- pendientes: Map<Integer, Object>

- ttlNanos: long

- maxFarmacias: int

- maxFilas: int


        + CacheFarmacia(ttlSegundos: int, maxFarmacias: int, maxFilas: int)
        + invalidarFarmacia(farmacia: int): void
        + invalidarTodo(): void
        + estadisticas(): String
    }

    class VistasCache <<cache de vistas>> {
- {static} CATALOGO: CacheFarmacia

- {static} LOTES: CacheFarmacia


        + {static} invalidarFarmacia(farmacia: int): void
        + {static} invalidarTodo(): void
        + {static} metricas(): String
    }
}

' ============================================================
' 12. SESION Y CONTEXTO DE FARMACIA
' ============================================================
package "session" {
    class SesionUsuario <<session context>> {
- {static} actual: DatosUsuario


        + {static} iniciar(usuario: Usuario): void
        + {static} estaActiva(): boolean
        + {static} actual(): DatosUsuario
        + {static} usuarioParaFachada(): Usuario
        + {static} cerrar(): void
    }

    class DatosUsuario <<record anidado>> {
        + id: int
        + nombre: String
        + email: String
        + rol: String
        + idFarmacia: Integer
        + farmacia: String
    }
}

' ============================================================
' 13. RELACIONES DE PERSISTENCIA (UML Estricto)
' ============================================================
CatalogoDAO <|-- AseoDAO : extiende
CatalogoDAO <|-- MaternidadDAO : extiende

LoteDAO <|.. LoteDAOImpl
MedicamentoDAO <|.. MedicamentoDAOImpl
UsuarioDAO <|.. UsuarioDAOImpl
ConsultaInventario <|.. ConsultaInventarioDAO
ConsultaInventario <|.. ConsultaInventarioProxy

CatalogoDAO ..> ConexionBD : JDBC
CatalogoDAO ..> Validable : requiere validacion
CatalogoDAO ..> RegistroCatalogo : crea / retorna

LoteDAOImpl ..> ConexionBD : JDBC
MedicamentoDAOImpl ..> ConexionBD : JDBC
UsuarioDAOImpl ..> ConexionBD : JDBC
MedicamentoCatalogoDAO ..> ConexionBD : JDBC
AseoDAO ..> ConexionBD : JDBC
MaternidadDAO ..> ConexionBD : JDBC
ConsultaInventarioDAO ..> ConexionBD : JDBC

UsuarioDAOImpl ..> Usuario : mapea
MedicamentoDAOImpl ..> Medicamento : mapea
MedicamentoCatalogoDAO ..> Medicamento : mapea
LoteDAOImpl ..> Lote : mapea
AseoDAO ..> Aseo : mapea
MaternidadDAO ..> Maternidad : mapea
ConsultaInventarioDAO ..> ProductoInventario : devuelve

AseoDAO ..> FabricaProducto : utiliza
AseoDAO ..> FabricaAseo : crea / valida
MaternidadDAO ..> FabricaProducto : utiliza
MaternidadDAO ..> FabricaMaternidad : crea / valida

' ============================================================
' 14. CONTROLADORES / APLICACION
' ============================================================
LoginController --> AuthenticationService : utiliza
AuthenticationService --> UsuarioDAO : consulta
LoginController ..> SesionUsuario : inicia sesion

InventarioController --> Inventario : utiliza
CatalogoController --> Inventario : utiliza
ConsultaInventarioController --> Inventario : utiliza
ConsultaInventarioController ..> FiltroProductoInventario : filtra

CareStockApp --> LoginController : carga FXML
CareStockApp --> InventarioController : carga FXML
CareStockApp --> CatalogoController : carga FXML
CareStockApp --> ConsultaInventarioController : carga FXML
CareStockApp ..> SesionUsuario : cierre de sesion
Launcher ..> CareStockApp : inicia
PruebaConexion ..> ConexionBD : verifica

CatalogoController ..> FabricaProducto : delega construccion
CatalogoController ..> FabricaAseo : crea aseo
CatalogoController ..> FabricaMaternidad : crea maternidad
CatalogoController ..> FabricaMedicamento : crea medicamento

' ============================================================
' 15. FACHADA Y SERVICIOS
' ============================================================
Inventario --> AseoDAO : gestiona
Inventario --> MaternidadDAO : gestiona
Inventario --> MedicamentoDAO : utiliza
Inventario --> MedicamentoCatalogoDAO : gestiona
Inventario --> LoteDAO : consulta
Inventario --> RegistroLoteService : registra lotes
Inventario --> FarmacovigilanciaService : dispensa
Inventario --> ConsultaInventario : consulta unificada
Inventario ..> SesionUsuario : valida contexto
Inventario ..> InventarioConsultas : invalida cache

RegistroLoteService ..> ConexionBD : JDBC
FarmacovigilanciaService ..> ConexionBD : JDBC
RegistroLoteService ..> Lote : registra
FarmacovigilanciaService ..> Lote : dispensa

' ============================================================
' 16. VALIDACIONES Y REGLAS DE NEGOCIO
' ============================================================
Validable <|.. Medicamento
Validable <|.. Cosmetico
Validable <|.. DispositivoMedico
Validable <|.. Aseo
Validable <|.. Maternidad
Validable <|.. Lote
Validable <|.. AlertaInvima
Validable ..> ReglaNegocioException : lanza

' ============================================================
' 17. FACTORY METHOD
' ============================================================
FabricaProducto <|-- FabricaAseo
FabricaProducto <|-- FabricaMaternidad
FabricaProducto <|-- FabricaMedicamento

FabricaProducto ..> Validable : crea y valida
FabricaAseo --> Aseo : instancia
FabricaMaternidad --> Maternidad : instancia
FabricaMedicamento --> Medicamento : instancia

' ============================================================
' 18. MODELO, DTO, PROXY Y SESION
' ============================================================
Medicamento "1" -- "0..*" Lote : posee
SesionUsuario *-- DatosUsuario : conserva
SesionUsuario ..> Usuario : autentica
SesionUsuario ..> InventarioConsultas : invalida al cambiar

RegistroCatalogo ..> Medicamento : contiene
RegistroCatalogo ..> Aseo : contiene
RegistroCatalogo ..> Maternidad : contiene
DatosCatalogo o--> RegistroCatalogo : productos
DatosLotes o--> Lote : lotes
FiltroProductoInventario ..> ProductoInventario : filtra

ConsultaInventarioProxy --> ConsultaInventario : RealSubject
InventarioConsultas o--> ConsultaInventarioProxy : instancia compartida
ConsultaInventarioProxy ..> SesionUsuario : autoriza farmacia
ConsultaInventarioProxy --> ProductoInventario : almacena
VistasCache *-- CacheFarmacia : gestiona caches
VistasCache ..> DatosCatalogo : cache catalogo
VistasCache ..> DatosLotes : cache lotes
Inventario ..> EscrituraInventario : coordina escritura
ConsultaInventarioProxy *-- ProxyEntrada : almacena
ConsultaInventarioProxy *-- ProxyCarga : coordina cargas

' ============================================================
' 19. NOTAS DE DISENO (Estructura uniforme para patrones GoF)
' ============================================================
note bottom of CatalogoDAO
  Patron GoF Template Method:
  Las operaciones CRUD son metodos final que
  fijan el algoritmo de acceso a los datos.
  AseoDAO y MaternidadDAO especializan
  tabla, columnas, parametros y mapeo.
  Reutiliza validaciones y JDBC comunes.
end note

note bottom of FabricaProducto
  Patron GoF Factory Method:
  Define el metodo de creacion crearInstancia()
  y concentra la validacion comun en crear(...).
  Las subclases deciden que producto concreto
  se instancia segun la categoria.
end note

note right of FabricaAseo
  Concrete Creator:
  Especializa la creacion del producto Aseo.
end note

note right of FabricaMedicamento
  Concrete Creator:
  Especializa la creacion del producto Medicamento.
end note

note bottom of Inventario
  Patron Facade:
  Coordina catalogo, lotes y dispensacion
  para el usuario y farmacia activos.
  Invalida el Proxy tras escrituras.
end note

note right of ConsultaInventarioProxy
  Patron GoF Proxy (Caching Proxy):
  Representa el Proxy del Subject ConsultaInventario.
  - Implementa cache LRU por farmacia con TTL configurable.
  - Evita lecturas concurrentes duplicadas hacia la BD.
  - Valida permisos de acceso por sesion de usuario.
  - Permite invalidacion total o por farmacia.
end note

note bottom of InventarioConsultas
  Instancia compartida (Singleton):
  Conserva un unico ConsultaInventarioProxy
  mediante un atributo static final.
  compartida() devuelve esa instancia;
  no genera un Proxy por controlador.
end note

note bottom of VistasCache
  Patron Caching:
  Infraestructura para cachear DTOs
  de catalogo y lotes de manera centralizada.
end note

note bottom of ConsultaInventarioController
  Observacion reactiva de JavaFX:
  Los listeners de propiedades actualizan
  filtros y seleccion en la vista.
  Es uso de la API JavaFX; no se declara
  un Observer de dominio propio.
end note

note bottom of AlertaInvima
  Modelo Historico / Test:
  Incluida para conservar la trazabilidad
  del modelo (se ubica en src/test/java).
end note

@enduml