<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.carestock.controller.ControladorReposicion"
            prefWidth="1180" prefHeight="750"
            style="-fx-background-color: #FDFBF7;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: #A7D8D8; -fx-padding: 20 28;">
            <Label text="CareStock · Planificación de reposición"
                   style="-fx-font-size: 21; -fx-font-weight: bold; -fx-text-fill: #20302F;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver al inventario"
                    onAction="#onVolver"
                    style="-fx-background-color: #EDE7F7; -fx-text-fill: #6B5B95; -fx-font-weight: bold; -fx-padding: 10 16;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16"
              style="-fx-padding: 24 28;">

            <Label fx:id="lblFarmacia"
                   text="Farmacia"
                   style="-fx-font-size: 16; -fx-font-weight: bold;"/>

            <Label text="Productos agotados o con existencias iguales o inferiores al stock mínimo"
                   style="-fx-text-fill: #2E4A48;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Categoría"/>
                <ComboBox fx:id="cmbCategoria" prefWidth="170"/>
                <Label text="Severidad"/>
                <ComboBox fx:id="cmbSeveridad" prefWidth="160"/>

                <TextField fx:id="txtBuscar"
                           promptText="Buscar por código o producto"
                           prefWidth="280"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnActualizar"
                        text="Actualizar"
                        onAction="#onActualizar"
                        style="-fx-background-color: #EDE7F7; -fx-text-fill: #6B5B95; -fx-font-weight: bold; -fx-padding: 10 16;"/>

                <Button fx:id="btnExportarCsv"
                        text="Exportar CSV"
                        onAction="#onExportarCsv"
                        style="-fx-background-color: #B7A6E0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 16;"/>
            </HBox>

            <TableView fx:id="tablaReposicion"
                       VBox.vgrow="ALWAYS"
                       prefHeight="460"
                       style="-fx-background-color: white; -fx-border-color: #E3D9F5;">
                <columns>
                    <TableColumn fx:id="colCodigo"
                                 text="Código" prefWidth="125"/>
                    <TableColumn fx:id="colProducto"
                                 text="Producto" prefWidth="245"/>
                    <TableColumn fx:id="colCategoria"
                                 text="Categoría" prefWidth="135"/>
                    <TableColumn fx:id="colExistencias"
                                 text="Existencias" prefWidth="110"/>
                    <TableColumn fx:id="colMinimo"
                                 text="Stock mínimo" prefWidth="110"/>
                    <TableColumn fx:id="colFaltante"
                                 text="Faltante" prefWidth="105"/>
                    <TableColumn fx:id="colSeveridad"
                                 text="Severidad" prefWidth="135"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="18">
                <Label fx:id="lblEstado"
                       text="Preparando consulta..."/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo"
                       text="Productos visibles: 0"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
