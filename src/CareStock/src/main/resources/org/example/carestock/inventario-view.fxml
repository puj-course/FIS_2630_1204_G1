<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.carestock.controller.InventarioController"
            prefWidth="1100.0"
            prefHeight="750.0"
            style="-fx-background-color: #FDFBF7;">

    <!-- ======================================= -->
    <!-- CABECERA PRINCIPAL                      -->
    <!-- ======================================= -->

    <top>
        <VBox spacing="14.0"
              style="-fx-background-color: #A7D8D8; -fx-padding: 20 28 20 28;">

            <children>

                <!-- Marca y navegacion -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>

                        <StackPane prefHeight="44.0"
                                   prefWidth="44.0">
                            <children>
                                <Circle fill="#FDFBF7"
                                        radius="22.0" />

                                <Rectangle fill="#B7A6E0"
                                           height="22.0"
                                           arcHeight="3.0"
                                           arcWidth="3.0"
                                           width="6.0" />

                                <Rectangle fill="#B7A6E0"
                                           height="6.0"
                                           arcHeight="3.0"
                                           arcWidth="3.0"
                                           width="22.0" />
                            </children>
                        </StackPane>

                        <VBox alignment="CENTER_LEFT"
                              spacing="2.0">
                            <children>

                                <Label text="CareStock"
                                       textFill="#20302F">
                                    <font>
                                        <Font name="System Bold"
                                              size="24.0" />
                                    </font>
                                </Label>

                                <Label text="Control de Inventario"
                                       textFill="#2E4A48">
                                    <font>
                                        <Font name="System Bold"
                                              size="12.0" />
                                    </font>
                                </Label>

                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnCatalogo"
                                text="Catálogo"
                                onAction="#onAbrirCatalogo"
                                style="-fx-background-color: #B7A6E0; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;" />

                        <Button text="Cerrar sesión"
                                onAction="#onCerrarSesion"
                                style="-fx-background-color: rgba(32,48,47,0.08); -fx-text-fill: #20302F; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(32,48,47,0.25); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;" />

                    </children>
                </HBox>

                <!-- Informacion de sesion -->
                <HBox spacing="14.0"
                      alignment="CENTER_LEFT">

                    <children>

                        <VBox spacing="4.0"
                              HBox.hgrow="ALWAYS"
                              alignment="CENTER_LEFT"
                              style="-fx-background-color: rgba(253,251,247,0.70); -fx-background-radius: 12; -fx-padding: 12 16;">

                            <children>

                                <Label text="USUARIO AUTENTICADO"
                                       textFill="#2E4A48"
                                       style="-fx-font-size: 10; -fx-font-weight: bold;" />

                                <Label fx:id="lblUsuarioSesion"
                                       text="Cargando usuario..."
                                       textFill="#20302F"
                                       style="-fx-font-size: 16; -fx-font-weight: bold;" />

                                <Label fx:id="lblEmailSesion"
                                       text="correo@ejemplo.com"
                                       textFill="#2E4A48"
                                       style="-fx-font-size: 12;" />

                            </children>
                        </VBox>

                        <VBox spacing="4.0"
                              alignment="CENTER_LEFT"
                              prefWidth="200.0"
                              style="-fx-background-color: rgba(253,251,247,0.70); -fx-background-radius: 12; -fx-padding: 12 16;">

                            <children>

                                <Label text="ROL DEL USUARIO"
                                       textFill="#2E4A48"
                                       style="-fx-font-size: 10; -fx-font-weight: bold;" />

                                <Label fx:id="lblRolSesion"
                                       text="Cargando..."
                                       textFill="#20302F"
                                       style="-fx-font-size: 15; -fx-font-weight: bold;" />

                            </children>
                        </VBox>

                        <VBox spacing="4.0"
                              alignment="CENTER_LEFT"
                              prefWidth="220.0"
                              style="-fx-background-color: rgba(253,251,247,0.70); -fx-background-radius: 12; -fx-padding: 12 16;">

                            <children>

                                <Label text="FARMACIA ASIGNADA"
                                       textFill="#2E4A48"
                                       style="-fx-font-size: 10; -fx-font-weight: bold;" />

                                <Label fx:id="lblFarmaciaSesion"
                                       text="Cargando..."
                                       textFill="#20302F"
                                       style="-fx-font-size: 15; -fx-font-weight: bold;" />

                            </children>
                        </VBox>

                    </children>
                </HBox>

                <Label text="Gestión de inventario, trazabilidad y dispensación segura"
                       textFill="#2E4A48"
                       style="-fx-font-size: 12;" />

            </children>
        </VBox>
    </top>

    <!-- ======================================= -->
    <!-- CONTENIDO PRINCIPAL                     -->
    <!-- ======================================= -->

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: #FDFBF7; -fx-background-color: #FDFBF7; -fx-border-color: transparent;">
            <content>
                <VBox spacing="16.0"
                      style="-fx-background-color: #FDFBF7;">

            <padding>
                <Insets top="22.0"
                        right="28.0"
                        bottom="16.0"
                        left="28.0" />
            </padding>

            <children>

                <!-- Titulo de seccion -->
                <HBox alignment="CENTER_LEFT"
                      spacing="12.0">

                    <children>

                        <Label text="Inventario de Lotes"
                               textFill="#20302F">
                            <font>
                                <Font name="System Bold"
                                      size="20.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button text="Actualizar tabla"
                                onAction="#onRefrescar"
                                style="-fx-background-color: #0E7C7B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 18;" />

                    </children>
                </HBox>

                <!-- ================================== -->
                <!-- INDICADORES DE LOTES               -->
                <!-- ================================== -->

                <HBox spacing="16.0"
                      alignment="CENTER_LEFT">

                    <children>

                        <!-- Total de lotes -->
                        <VBox spacing="6.0"
                              prefWidth="240.0"
                              style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #D6E6E4; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(14,124,123,0.10), 14, 0, 0, 5); -fx-padding: 18;">

                            <children>

                                <Label text="TOTAL DE LOTES"
                                       textFill="#6D8683"
                                       style="-fx-font-size: 11; -fx-font-weight: bold;" />

                                <Label fx:id="lblTotalLotes"
                                       text="0"
                                       textFill="#0E7C7B"
                                       style="-fx-font-size: 28; -fx-font-weight: bold;" />

                                <Button text="Ver todos →"
                                        onAction="#onFiltrarTodos"
                                        style="-fx-background-color: transparent; -fx-text-fill: #0E7C7B; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" />

                            </children>
                        </VBox>

                        <!-- Lotes vencidos -->
                        <VBox spacing="6.0"
                              prefWidth="240.0"
                              style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #D6E6E4; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(14,124,123,0.10), 14, 0, 0, 5); -fx-padding: 18;">

                            <children>

                                <Label text="LOTES VENCIDOS"
                                       textFill="#6D8683"
                                       style="-fx-font-size: 11; -fx-font-weight: bold;" />

                                <Label fx:id="lblLotesVencidos"
                                       text="0"
                                       textFill="#C53030"
                                       style="-fx-font-size: 28; -fx-font-weight: bold;" />

                                <Button text="Ver vencidos →"
                                        onAction="#onFiltrarVencidos"
                                        style="-fx-background-color: transparent; -fx-text-fill: #C53030; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" />

                            </children>
                        </VBox>

                        <!-- Disponibles -->
                        <VBox spacing="6.0"
                              prefWidth="240.0"
                              style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #D6E6E4; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(14,124,123,0.10), 14, 0, 0, 5); -fx-padding: 18;">

                            <children>

                                <Label text="DISPENSACIÓN"
                                       textFill="#6D8683"
                                       style="-fx-font-size: 11; -fx-font-weight: bold;" />

                                <Label text="Disponibles"
                                       textFill="#2F855A"
                                       style="-fx-font-size: 22; -fx-font-weight: bold;" />

                                <Button text="Ver aptos →"
                                        onAction="#onFiltrarDisponibles"
                                        style="-fx-background-color: transparent; -fx-text-fill: #2F855A; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" />

                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- ================================== -->
                <!-- CONTADORES POR CATEGORIA           -->
                <!-- CORRECCION DE LA INTEGRACION       -->
                <!-- ================================== -->

                <HBox spacing="18.0"
                      alignment="CENTER_LEFT"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 12 18; -fx-border-color: #D6E6E4; -fx-border-radius: 10;">

                    <children>

                        <Label text="Medicamentos:"
                               style="-fx-font-weight: bold;" />

                        <Label fx:id="lblTotalMedicamentos"
                               text="0"
                               style="-fx-text-fill: #0E7C7B; -fx-font-weight: bold;" />

                        <Label text="Aseo:"
                               style="-fx-font-weight: bold;" />

                        <Label fx:id="lblTotalAseo"
                               text="0"
                               style="-fx-text-fill: #0E7C7B; -fx-font-weight: bold;" />

                        <Label text="Maternidad:"
                               style="-fx-font-weight: bold;" />

                        <Label fx:id="lblTotalMaternidad"
                               text="0"
                               style="-fx-text-fill: #0E7C7B; -fx-font-weight: bold;" />

                    </children>
                </HBox>

                <!-- ================================== -->
                <!-- BARRA DE BUSQUEDA                  -->
                <!-- ================================== -->

                <HBox spacing="12.0"
                      alignment="CENTER_LEFT">

                    <children>

                        <TextField fx:id="txtBuscar"
                                   prefHeight="42.0"
                                   prefWidth="360.0"
                                   promptText="Buscar por lote, medicamento o estado"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D6E6E4; -fx-padding: 0 12;" />

                        <Label text="Categoría:"
                               textFill="#20302F"
                               style="-fx-font-weight: bold; -fx-font-size: 12;" />

                        <ComboBox fx:id="cmbCategoria"
                                  prefHeight="42.0"
                                  prefWidth="220.0"
                                  promptText="Seleccionar categoría"
                                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D6E6E4;" />

                    </children>
                </HBox>

                <!-- ================================== -->
                <!-- TABLA DE LOTES                     -->
                <!-- ================================== -->

                <TableView fx:id="tablaLotes"
                           minHeight="310.0"
                           prefHeight="360.0"
                           style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #D6E6E4; -fx-border-width: 1;">

                    <columns>

                        <TableColumn fx:id="colIdLote"
                                     text="ID Lote"
                                     prefWidth="80.0" />

                        <TableColumn fx:id="colNumeroLote"
                                     text="Número de Lote"
                                     prefWidth="160.0" />

                        <TableColumn fx:id="colIdMedicamento"
                                     text="ID Medicamento"
                                     prefWidth="140.0" />

                        <TableColumn fx:id="colCantidad"
                                     text="Cantidad"
                                     prefWidth="120.0" />

                        <TableColumn fx:id="colFechaVencimiento"
                                     text="Fecha Vencimiento"
                                     prefWidth="170.0" />

                        <TableColumn fx:id="colEstado"
                                     text="Estado Sanitario"
                                     prefWidth="170.0" />

                    </columns>
                </TableView>

                <!-- MODULO DE DISPENSACION -->
                <VBox style="-fx-background-color: #FDFBF7; -fx-padding: 0 0 6 0;">

            <children>

                <VBox spacing="12.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-color: #D6E6E4; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(14,124,123,0.12), 20, 0, 0, 8); -fx-padding: 20 24;">

                    <children>

                        <Label text="Módulo de Dispensación"
                               textFill="#20302F">
                            <font>
                                <Font name="System Bold"
                                      size="16.0" />
                            </font>
                        </Label>

                        <HBox spacing="18.0"
                              alignment="CENTER_LEFT">

                            <children>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Lote seleccionado"
                                               textFill="#6D8683"
                                               style="-fx-font-size: 12;" />

                                        <Label fx:id="lblLoteSeleccionadoInfo"
                                               text="Ninguno (seleccione una fila)"
                                               wrapText="true"
                                               textFill="#20302F"
                                               style="-fx-font-weight: bold;" />

                                    </children>
                                </VBox>

                                <VBox spacing="5.0">

                                    <children>

                                        <Label text="Cantidad a dispensar"
                                               textFill="#20302F"
                                               style="-fx-font-size: 12; -fx-font-weight: bold;" />

                                        <TextField fx:id="txtCantidad"
                                                   prefHeight="42.0"
                                                   prefWidth="140.0"
                                                   promptText="Ej: 2"
                                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D6E6E4; -fx-padding: 0 12;" />

                                    </children>
                                </VBox>

                                <Button text="Dispensar medicamento"
                                        onAction="#onDispensar"
                                        prefHeight="44.0"
                                        style="-fx-background-color: #0E7C7B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 24;" />

                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
                </VBox>
            </children>
        </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
