# Copie estos valores en variables de entorno locales. NO suba credenciales reales a Git.
DB_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require
DB_USER=usuario_postgresql
DB_PASSWORD=contraseña_postgresql

# Usuario de CareStock utilizado para la trazabilidad de movimientos mientras no exista login.
# Debe existir en USUARIOS y tener estado ACTIVO.
CARESTOCK_USER_EMAIL=admin@carestock.com

# Pool JDBC - rendimiento
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1

# ==========================================
# HU.130 / #891 - Notificaciones SMS
# ==========================================
SMS_PROVIDER=simulado
SMS_ALLOWED_TO=+573001234567
SMS_CONFIRM_REAL_SEND=NO

# Solo para integracion Twilio
TWILIO_ACCOUNT_SID=AC_REEMPLAZAR
TWILIO_AUTH_TOKEN=REEMPLAZAR_LOCALMENTE
TWILIO_FROM_NUMBER=+15005550006

# HU.130 - SMS reales mediante Android
# El dispositivo Android emisor debe estar en la misma LAN.
SMS_PROVIDER=android
SMS_GATEWAY_URL=http://192.168.1.50:8080
SMS_GATEWAY_USERNAME=REEMPLAZAR
SMS_GATEWAY_PASSWORD=REEMPLAZAR
SMS_CONFIRM_REAL_SEND=NO
SMS_MODO_TRIAL=NO
SMS_MAX_POR_CICLO=1
