        + setNombre(nombre: String): DispositivoMedicoBuilder
        + setDescripcion(texto: String): DispositivoMedicoBuilder
        + setPrecio(precio: double): DispositivoMedicoBuilder
        + setStock(stock: int): DispositivoMedicoBuilder
