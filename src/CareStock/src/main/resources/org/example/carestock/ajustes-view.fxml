<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.carestock.controller.ControladorAjustes"
            prefWidth="1100"
            prefHeight="750"
            style="-fx-background-color: #F4FAF9;">

    <top>
        <VBox spacing="13"
              style="-fx-padding: 22 30; -fx-background-color: #0E7C7B;">

            <HBox alignment="CENTER_LEFT" spacing="12">

                <Label text="CareStock / Ajustes de inventario"
                       textFill="WHITE"
                       style="-fx-font-size: 23; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Volver al inventario"
                        onAction="#onVolver"
                        style="-fx-background-color: WHITE; -fx-text-fill: #0B615F; -fx-background-radius: 9; -fx-padding: 10 16;"/>
            </HBox>

            <Label text="Ajustes justificados - Exclusivo para administradores"
                   textFill="#D6EFED"/>

            <HBox spacing="22">

                <Label text="Administrador:" textFill="WHITE"/>

                <Label fx:id="lblUsuario"
                       textFill="WHITE"
                       style="-fx-font-weight: bold;"/>

                <Label text="Farmacia:" textFill="WHITE"/>

                <Label fx:id="lblFarmacia"
                       textFill="WHITE"
                       style="-fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F4FAF9;">

            <content>
                <VBox spacing="18"
                      maxWidth="850"
                      style="-fx-padding: 26 32; -fx-background-color: #F4FAF9;">

                    <Label text="Formulario de ajustes de existencias"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #20302F;"/>

                    <Label text="Los medicamentos se ajustan por lote; aseo y maternidad por producto."
                           wrapText="true"
                           style="-fx-text-fill: #57716F;"/>

                    <VBox spacing="15"
                          style="-fx-background-color: WHITE; -fx-background-radius: 16; -fx-padding: 24; -fx-border-color: #D9E8E6; -fx-border-radius: 16;">

                        <Label text="1. Seleccion de referencia"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0B615F;"/>

                        <HBox spacing="12">

                            <VBox spacing="7" HBox.hgrow="ALWAYS">

                                <Label text="Categoria *"
                                       style="-fx-font-weight: bold;"/>

                                <ComboBox fx:id="cmbCategoria"
                                          maxWidth="Infinity"
                                          prefHeight="42"/>
                            </VBox>

                            <VBox spacing="7" HBox.hgrow="ALWAYS">

                                <Label text="Producto o lote *"
                                       style="-fx-font-weight: bold;"/>

                                <ComboBox fx:id="cmbReferencia"
                                          maxWidth="Infinity"
                                          prefHeight="42"
                                          promptText="Seleccionar referencia"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14" alignment="CENTER_LEFT">

                            <Label fx:id="lblExistencias"
                                   text="Selecciona un producto o lote."
                                   wrapText="true"
                                   style="-fx-text-fill: #0B615F; -fx-font-weight: bold;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnActualizar"
                                    text="Actualizar existencias"
                                    onAction="#onActualizar"
                                    style="-fx-background-color: #E4F3F1; -fx-text-fill: #0B615F; -fx-padding: 10 15; -fx-background-radius: 8;"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14"
                          style="-fx-background-color: WHITE; -fx-background-radius: 16; -fx-padding: 24; -fx-border-color: #D9E8E6; -fx-border-radius: 16;">

                        <Label text="2. Datos del ajuste"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0B615F;"/>

                        <Label text="Nueva cantidad (unidades) *"
                               style="-fx-font-weight: bold;"/>

                        <TextField fx:id="txtNuevaCantidad"
                                   promptText="Ej.: 15 (se permite 0)"
                                   prefHeight="42"/>

                        <Label text="Motivo del ajuste *"
                               style="-fx-font-weight: bold;"/>

                        <TextArea fx:id="txtMotivo"
                                  promptText="Explica por que es necesario modificar las existencias"
                                  prefRowCount="3"
                                  wrapText="true"/>

                        <Label text="* Campos obligatorios. Motivo de maximo 250 caracteres."
                               wrapText="true"
                               style="-fx-text-fill: #667F7C; -fx-font-size: 11;"/>
                    </VBox>

                    <VBox spacing="8"
                          style="-fx-background-color: #E9F4F3; -fx-padding: 18; -fx-background-radius: 12;">

                        <Label text="Estado del ajuste"
                               style="-fx-font-weight: bold; -fx-text-fill: #0B615F;"/>

                        <Label fx:id="lblEstado"
                               text="Consultando inventario..."
                               wrapText="true"/>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12">

                        <Button text="Volver"
                                onAction="#onVolver"
                                style="-fx-background-color: #EDF1F0; -fx-padding: 12 24; -fx-background-radius: 9;"/>

                        <Button fx:id="btnAplicar"
                                text="Confirmar ajuste"
                                onAction="#onAplicar"
                                style="-fx-background-color: #0E7C7B; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 9;"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
