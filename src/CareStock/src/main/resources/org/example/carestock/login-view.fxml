<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.carestock.controller.LoginController">
    <children>
        <!-- Panel Lateral Decorativo -->
        <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="12.0" style="-fx-background-color: linear-gradient(to bottom right, #0E7C7B, #0B615F); -fx-padding: 60;">
            <children>
                <Label text="Control de inventario,&#10;lotes y vencimientos&#10;en un solo lugar." textFill="WHITE" wrapText="true">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Trazabilidad en tiempo real y farmacovigilancia integrada." textFill="#e3f3f2" wrapText="true">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- Contenedor Centrado de la Tarjeta -->
        <VBox alignment="CENTER" style="-fx-background-color: #F4FAF9;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <!-- Tarjeta de Login -->
                <VBox alignment="CENTER_LEFT" maxWidth="380.0" spacing="14.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-color: #D6E6E4; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(14,124,123,0.12), 20, 0, 0, 8); -fx-padding: 32;">
                    <children>
                        <!-- Marca / Logo -->
                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                            <children>
                                <StackPane prefHeight="44.0" prefWidth="44.0">
                                    <children>
                                        <Circle fill="#E3F3F2" radius="22.0" />
                                        <Rectangle fill="#0E7C7B" height="22.0" arcHeight="3.0" arcWidth="3.0" width="6.0" />
                                        <Rectangle fill="#0E7C7B" height="6.0" arcHeight="3.0" arcWidth="3.0" width="22.0" />
                                    </children>
                                </StackPane>
                                <VBox alignment="CENTER_LEFT" spacing="2.0">
                                    <children>
                                        <Label text="CareStock" textFill="#20302F">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Label text="Sistema de Gestión Farmacéutica" textFill="#6D8683">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Label text="Inicia sesión para gestionar tu inventario de medicamentos y normatividad INVIMA." textFill="#6D8683" wrapText="true">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>

                        <!-- Campo Correo -->
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Correo institucional" textFill="#20302F">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtEmail" onAction="#onEmailAction" prefHeight="42.0" promptText="nombre@carestock.com" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D6E6E4; -fx-padding: 0 12;" />
                            </children>
                        </VBox>

                        <!-- Campo Contraseña -->
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Contraseña" textFill="#20302F">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtPassword" onAction="#onPasswordAction" prefHeight="42.0" promptText="••••••••" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D6E6E4; -fx-padding: 0 12;" />
                            </children>
                        </VBox>

                        <CheckBox fx:id="chkRecordarme" text="Recordar mi correo" textFill="#6D8683">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </CheckBox>

                        <Button fx:id="btnIngresar" defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#onIngresar" prefHeight="44.0" style="-fx-background-color: #0E7C7B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Iniciar sesión" />

                        <Label fx:id="lblNotificacion" maxWidth="1.7976931348623157E308" visible="false" wrapText="true" />

                        <Separator style="-fx-background-color: #D6E6E4;" />

                        <Label text="Acceso exclusivo para personal autorizado de farmacia y regentes IPS." textFill="#6D8683" wrapText="true">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>