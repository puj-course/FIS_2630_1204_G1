<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.carestock.controller.ControladorCatalogo" prefWidth="1150.0" prefHeight="760.0" style="-fx-background-color: #FDFBF7; -fx-accent: #B7A6E0; -fx-focus-color: #B7A6E0; -fx-faint-focus-color: rgba(183,166,224,0.25);">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: #A7D8D8; -fx-padding: 20 28 20 28;">
            <children>
                <StackPane prefHeight="44.0" prefWidth="44.0">
                    <children>
                        <Circle fill="#FDFBF7" radius="22.0" />
                        <Rectangle fill="#B7A6E0" height="22.0" arcHeight="3.0" arcWidth="3.0" width="6.0" />
                        <Rectangle fill="#B7A6E0" height="6.0" arcHeight="3.0" arcWidth="3.0" width="22.0" />
                    </children>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label text="CareStock" textFill="#20302F">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Catálogo de productos" textFill="#45605C">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Consulta unificada" onAction="#onConsultaUnificada" style="-fx-background-color: #B7A6E0; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;" />
                <Button text="Volver al inventario" onAction="#onVolver" style="-fx-background-color: rgba(32,48,47,0.08); -fx-text-fill: #20302F; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(32,48,47,0.25); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;" />
                <Button text="Cerrar sesión" onAction="#onCerrarSesion" style="-fx-background-color: rgba(32,48,47,0.08); -fx-text-fill: #20302F; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(32,48,47,0.25); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;" />
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollCatalogo"
                    fitToWidth="true" pannable="true"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: #FDFBF7; -fx-background-color: #FDFBF7;">
            <content>
        <StackPane style="-fx-background-color: #FDFBF7;">
            <children>
                <VBox spacing="12" style="-fx-background-color: #FDFBF7; -fx-padding: 10 18 12 18;" maxWidth="Infinity">
                    <children>
                        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12; -fx-border-color: #E3D9F5; -fx-border-radius: 12;">
                            <children>
                                <Label text="Categoría:" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                <ComboBox fx:id="cmbCategoria" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0;" />
                                <Label text="Buscar:" style="-fx-font-weight: bold;" />
                                <TextField fx:id="txtBuscar" promptText="Buscar codigo, nombre o descripcion..." prefHeight="40" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnLimpiar" text="Nuevo producto" onAction="#onNuevo" style="-fx-background-color: #B7A6E0;-fx-text-fill: white;-fx-font-weight: bold;-fx-background-radius: 8;-fx-padding: 10 13;-fx-cursor: hand;" />
                                <Button fx:id="btnEditarCatalogo" text="Editar seleccionado" onAction="#onEditarSeleccionado" style="-fx-background-color: #EDE7F7;-fx-text-fill: #62518C;-fx-font-weight: bold;-fx-background-radius: 8;-fx-padding: 10 13;-fx-cursor: hand;" />
                                <Button text="Actualizar lista" onAction="#onRefrescar" style="-fx-background-color: #EDE7F7; -fx-text-fill: #6B5B95; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 16;" />
                            </children>
                        </HBox>
                        <Label fx:id="lblEstado" text="Listo" wrapText="true" textFill="#6D8683" style="-fx-font-size: 12;" />
                        <FlowPane fx:id="leyendaStock"
                                  hgap="10" vgap="8"
                                  alignment="CENTER_LEFT"
                                  style="-fx-padding: 3 0 5 0;">
                            <children>
                                <Label text="ROJO: Sin existencias (stock 0)"
                                       style="-fx-background-color: #F0A8A8; -fx-text-fill: #7A2E2E; -fx-padding: 6 10; -fx-background-radius: 6; -fx-font-weight: bold;" />
                                <Label text="NARANJA: Stock bajo (menos del mínimo)"
                                       style="-fx-background-color: #F6CE8E; -fx-text-fill: #20302F; -fx-padding: 6 10; -fx-background-radius: 6;" />
                                <Label text="GRIS: Registro histórico inactivo"
                                       style="-fx-background-color: #ECEFF2; -fx-text-fill: #59636D; -fx-padding: 6 10; -fx-background-radius: 6;" />
                                <Label text="VERDE: Stock igual o superior al mínimo"
                                       style="-fx-background-color: #D8F2DF; -fx-text-fill: #236344; -fx-padding: 6 10; -fx-background-radius: 6;" />
                            </children>
                        </FlowPane>
                        <VBox fx:id="panelListaCompleta" visible="true" managed="true" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tablaProductos" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E3D9F5; -fx-border-width: 1;" prefHeight="410" VBox.vgrow="ALWAYS" minHeight="260">
                                    <columns>
                                        <TableColumn fx:id="colId" text="ID" prefWidth="55.0" />
                                        <TableColumn fx:id="colCodigo" text="Código / INVIMA" prefWidth="120.0" />
                                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150.0" />
                                        <TableColumn fx:id="colDescripcion" text="Descripción / P. activo" prefWidth="170.0" />
                                        <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90.0" />
                                        <TableColumn fx:id="colStock" text="Stock" prefWidth="60.0" />
                                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="80.0" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <StackPane fx:id="capaFormulario" visible="false" managed="false" pickOnBounds="true" style="-fx-background-color: rgba(21,31,41,0.58);-fx-padding: 12;">
                    <children>
                        <ScrollPane fitToWidth="true" style="-fx-background: #FDFBF7;-fx-border-color: #E3D9F5;-fx-border-radius: 12;" hbarPolicy="NEVER" maxWidth="980" maxHeight="700" prefHeight="580" vbarPolicy="AS_NEEDED">
                            <content>
                                <VBox style="-fx-background-color: #FDFBF7; -fx-padding: 3 8 8 8;">
                                    <children>
                                        <VBox fx:id="panelFormulario" spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E3D9F5; -fx-border-radius: 12;" maxWidth="Infinity">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="12">
                                                    <children>
                                                        <Label fx:id="lblSeleccion" text="Nuevo producto" textFill="#20302F">
                                                            <font>
                                                                <Font name="System Bold" size="19.0" />
                                                            </font>
                                                        </Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <FlowPane alignment="CENTER_RIGHT" hgap="8" vgap="8">
                                                            <children>
                                                                <Button text="Registrar" onAction="#onGuardar" style="-fx-background-color: #B7A6E0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 18;" fx:id="btnRegistrarFormulario" />
                                                                <Button text="Guardar cambios" onAction="#onActualizar" style="-fx-background-color: #EDE7F7; -fx-text-fill: #6B5B95; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 16;" fx:id="btnActualizarFormulario" />
                                                                <Button text="Desactivar" onAction="#onDesactivar" style="-fx-background-color: #F0A8A8; -fx-text-fill: #7A2E2E; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 16;" fx:id="btnDesactivarFormulario" />
                                                                <Button text="Simular Compra" onAction="#onSimularCompra" style="-fx-background-color: #A7D8D8; -fx-text-fill: #20302F; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 16;" fx:id="btnSimularFormulario" />
                                                                <Button text="Cerrar" onAction="#onCerrarFormulario" style="-fx-background-color: #F1F1F1;-fx-text-fill: #20302F;-fx-font-weight: bold;-fx-background-radius: 8;-fx-padding: 10 15;-fx-cursor: hand;" />
                                                            </children>
                                                        </FlowPane>
                                                    </children>
                                                </HBox>
                                                <Separator style="-fx-background-color: #E3D9F5;" />
                                                <HBox spacing="16" alignment="CENTER_LEFT">
                                                    <children>
                                                        <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                            <children>
                                                                <Label fx:id="lblCodigoCampo" text="Código" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                <TextField fx:id="txtCodigo" prefHeight="40.0" promptText="Código único por farmacia o INVIMA" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                            <children>
                                                                <Label fx:id="lblNombreCampo" text="Nombre" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                <TextField fx:id="txtNombre" prefHeight="40.0" promptText="Nombre del producto" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                                <VBox fx:id="panelDescripcion" spacing="6.0">
                                                    <children>
                                                        <Label text="Descripción obligatoria" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                        <TextField fx:id="txtDescripcion" prefHeight="40.0" promptText="Descripción del producto" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" />
                                                    </children>
                                                </VBox>
                                                <VBox fx:id="panelPrecioStock" spacing="6.0">
                                                    <children>
                                                        <HBox spacing="10.0">
                                                            <children>
                                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="Precio" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtPrecio" prefHeight="40.0" promptText="Ej: 15000.00" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="Stock" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtStock" prefHeight="40.0" promptText="Ej: 10" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <VBox fx:id="panelAseo" spacing="8.0">
                                                    <children>
                                                        <Separator style="-fx-background-color: #E3D9F5;" />
                                                        <Label text="CAMPOS DE ASEO" textFill="#6B5B95" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Tipo de aseo" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtTipoAseo" prefHeight="40.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Componentes activos" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtComponentesActivos" prefHeight="40.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Stock mínimo (genera alerta)" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtStockMinimoAseo" prefHeight="40.0" promptText="0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <CheckBox fx:id="chkBiodegradable" text="Biodegradable" textFill="#6D8683" />
                                                    </children>
                                                </VBox>
                                                <VBox fx:id="panelMaternidad" spacing="8.0" visible="false" managed="false">
                                                    <children>
                                                        <Separator style="-fx-background-color: #E3D9F5;" />
                                                        <Label text="CAMPOS DE MATERNIDAD" textFill="#6B5B95" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Etapa recomendada" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtEtapa" prefHeight="40.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Edad gestacional sugerida" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtEdadGestacional" prefHeight="40.0" promptText="Semanas" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Stock mínimo (genera alerta)" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtStockMinimoMaternidad" prefHeight="40.0" promptText="0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <CheckBox fx:id="chkHipoalergenico" text="Hipoalergénico" textFill="#6D8683" />
                                                    </children>
                                                </VBox>
                                                <VBox fx:id="panelMedicamentos" spacing="8.0" visible="false" managed="false">
                                                    <children>
                                                        <Separator style="-fx-background-color: #E3D9F5;" />
                                                        <Label text="CAMPOS DE MEDICAMENTOS" textFill="#6B5B95" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Principio activo (obligatorio)" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtPrincipioActivo" prefHeight="40.0" promptText="Ej: Paracetamol" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Concentración" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtConcentracion" prefHeight="40.0" promptText="Ej: 500 mg" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Forma farmacéutica" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtFormaFarmaceutica" prefHeight="40.0" promptText="Ej: Tableta" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Presentación" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtPresentacion" prefHeight="40.0" promptText="Ej: Caja x 20" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Categoría farmacológica (obligatoria)" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <ComboBox fx:id="cmbCategoriaMedicamento" maxWidth="Infinity" prefHeight="40.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0;" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Precio de venta (COP)" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtPrecioMedicamento" prefHeight="40.0" promptText="Ej: 15000.00" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox spacing="16" alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                                                    <children>
                                                                        <Label text="Stock mínimo (obligatorio)" textFill="#20302F" style="-fx-font-size: 12; -fx-font-weight: bold;" />
                                                                        <TextField fx:id="txtStockMinimo" prefHeight="40.0" promptText="Ej: 5" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D0D0D0; -fx-padding: 0 12;" maxWidth="Infinity" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <VBox spacing="4.0" style="-fx-background-color: #EDE7F7; -fx-background-radius: 10; -fx-padding: 12 14;">
                                                            <children>
                                                                <Label text="Stock total (solo lectura)" wrapText="true" textFill="#6D8683" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                                                <Label fx:id="lblStockMedicamento" text="0 (gestionado mediante lotes)" textFill="#6B5B95" style="-fx-font-weight: bold;" />
                                                                <Label text="Las existencias se gestionan mediante lotes." wrapText="true" textFill="#6D8683" style="-fx-font-size: 11;" />
                                                            </children>
                                                        </VBox>
                                                          <CheckBox fx:id="chkRequiereRefrigeracion" 
                                                          text="Requiere Cadena de Frío (Refrigeración)" 
                                                          textFill="#20302F" 
                                                          style="-fx-font-weight: bold;" />
                                                    </children>
                                                </VBox>
                                                <Separator style="-fx-background-color: #E3D9F5;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>
            </children>
        </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
