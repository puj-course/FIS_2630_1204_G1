<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            prefViewportHeight="650.0"
            prefViewportWidth="650.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.carestock.controller.IngresoLoteController">

    <content>

        <VBox prefWidth="620.0"
              spacing="16.0"
              stylesheets="@ingreso-lote.css">

            <padding>
                <Insets top="25.0"
                        right="25.0"
                        bottom="25.0"
                        left="25.0" />
            </padding>

            <children>

                <Label styleClass="dialog-titulo"
                       text="Registro de ingreso de lote" />

                <Label fx:id="lblUsuarioSesion"
                       text="Responsable: sesión activa"
                       styleClass="helper-text"
                       wrapText="true" />

                <Separator />

                <!-- ====================================== -->
                <!-- 1. MEDICAMENTO                         -->
                <!-- ====================================== -->

                <Label styleClass="section-title"
                       text="1. Medicamento" />

                <Label styleClass="helper-text"
                       wrapText="true"
                       text="Selecciona un medicamento existente. Si aún no está registrado, puedes agregarlo directamente desde este formulario." />

                <GridPane hgap="12.0"
                          vgap="10.0">

                    <columnConstraints>

                        <ColumnConstraints minWidth="145.0"
                                           prefWidth="145.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="330.0"
                                           prefWidth="370.0" />

                    </columnConstraints>

                    <children>

                        <Label text="Medicamento:"
                               GridPane.rowIndex="0" />

                        <ComboBox fx:id="cmbMedicamento"
                                  promptText="Seleccionar medicamento activo"
                                  prefWidth="Infinity"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="0" />

                        <Button fx:id="btnNuevoMedicamento"
                                text="+ Registrar nuevo medicamento"
                                onAction="#handleNuevoMedicamento"
                                styleClass="btn-secundario"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1" />

                    </children>

                </GridPane>


                <!-- ====================================== -->
                <!-- FORMULARIO INLINE NUEVO MEDICAMENTO    -->
                <!-- ====================================== -->

                <VBox fx:id="pnlNuevoMedicamento"
                      managed="false"
                      visible="false"
                      spacing="12.0"
                      styleClass="inline-form-card">

                    <children>

                        <Label text="Nuevo medicamento"
                               styleClass="inline-form-title" />

                        <Label text="Completa los datos generales. El stock inicial será 0 y aumentará cuando registres el lote."
                               wrapText="true"
                               styleClass="helper-text" />

                        <GridPane hgap="15.0"
                                  vgap="11.0">

                            <columnConstraints>

                                <ColumnConstraints minWidth="165.0"
                                                   prefWidth="165.0" />

                                <ColumnConstraints hgrow="ALWAYS"
                                                   minWidth="320.0"
                                                   prefWidth="350.0" />

                            </columnConstraints>

                            <children>

                                <Label text="Código INVIMA:"
                                       GridPane.rowIndex="0" />

                                <TextField fx:id="txtNuevoInvima"
                                           promptText="Ej: INVIMA-2026M-001"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0" />

                                <Label text="Nombre comercial:"
                                       GridPane.rowIndex="1" />

                                <TextField fx:id="txtNuevoNombre"
                                           promptText="Ej: Acetaminofén"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1" />

                                <Label text="Principio activo:"
                                       GridPane.rowIndex="2" />

                                <TextField fx:id="txtNuevoPrincipio"
                                           promptText="Ej: Paracetamol"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="2" />

                                <Label text="Concentración:"
                                       GridPane.rowIndex="3" />

                                <TextField fx:id="txtNuevaConcentracion"
                                           promptText="Ej: 500 mg"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="3" />

                                <Label text="Forma farmacéutica:"
                                       GridPane.rowIndex="4" />

                                <TextField fx:id="txtNuevaForma"
                                           promptText="Ej: Tableta"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="4" />

                                <Label text="Presentación:"
                                       GridPane.rowIndex="5" />

                                <TextField fx:id="txtNuevaPresentacion"
                                           promptText="Ej: Caja x 20 tabletas"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="5" />

                                <Label text="Categoría:"
                                       GridPane.rowIndex="6" />

                                <ComboBox fx:id="cmbNuevaCategoria"
                                          promptText="Seleccionar categoría"
                                          prefWidth="Infinity"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="6" />

                                <Label text="Stock mínimo:"
                                       GridPane.rowIndex="7" />

                                <TextField fx:id="txtNuevoStockMinimo"
                                           promptText="Ej: 10"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="7" />

                            </children>

                        </GridPane>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="10.0">

                            <children>

                                <Button text="Cancelar registro"
                                        onAction="#handleCancelarNuevoMedicamento"
                                        styleClass="btn-cancelar" />

                                <Button fx:id="btnGuardarNuevoMedicamento"
                                        text="Guardar medicamento"
                                        onAction="#handleGuardarNuevoMedicamento"
                                        styleClass="btn-guardar" />

                            </children>

                        </HBox>

                    </children>

                </VBox>


                <Separator />


                <!-- ====================================== -->
                <!-- 2. DATOS DEL LOTE                      -->
                <!-- ====================================== -->

                <Label styleClass="section-title"
                       text="2. Datos del lote" />

                <GridPane hgap="15.0"
                          vgap="15.0">

                    <columnConstraints>

                        <ColumnConstraints minWidth="145.0"
                                           prefWidth="145.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="330.0"
                                           prefWidth="370.0" />

                    </columnConstraints>

                    <children>

                        <Label text="Número de lote:"
                               GridPane.rowIndex="0" />

                        <TextField fx:id="txtNumeroLote"
                                   promptText="Ej: LOT-2026-001"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0" />

                        <Label text="Cantidad de unidades:"
                               GridPane.rowIndex="1" />

                        <TextField fx:id="txtCantidad"
                                   promptText="Ej: 100"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1" />

                        <Label text="Fecha de vencimiento:"
                               GridPane.rowIndex="2" />

                        <DatePicker fx:id="dpFechaVencimiento"
                                    promptText="dd/mm/aaaa"
                                    prefWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2" />

                        <Label text="Ubicación física:"
                               GridPane.rowIndex="3" />

                        <ComboBox fx:id="cmbUbicacion"
                                  promptText="Seleccionar estante / nivel"
                                  prefWidth="Infinity"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="3" />

                    </children>

                </GridPane>


                <HBox alignment="CENTER_RIGHT"
                      spacing="12.0">

                    <children>

                        <Button fx:id="btnCancelar"
                                text="Cancelar"
                                onAction="#handleCancelar"
                                styleClass="btn-cancelar" />

                        <Button fx:id="btnGuardar"
                                text="Guardar lote"
                                onAction="#handleGuardarLote"
                                styleClass="btn-guardar" />

                    </children>

                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>

                </HBox>

            </children>

        </VBox>

    </content>

</ScrollPane>
