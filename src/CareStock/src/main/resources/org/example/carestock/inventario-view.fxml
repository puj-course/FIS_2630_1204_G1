<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.carestock.controller.InventarioController"
        prefWidth="1100.0"
        prefHeight="750.0">

    <!-- ======================================= -->
    <!-- CABECERA PRINCIPAL                      -->
    <!-- ======================================= -->

    <top>

        <VBox spacing="12"
              style="-fx-background-color: #1A365D;
                     -fx-padding: 18;">

            <!-- TITULO Y NAVEGACION -->

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <Label
                        text="CareStock - Control de Inventario"
                        textFill="WHITE"
                        style="-fx-font-size: 22;
                           -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="Catálogo"
                        onAction="#onAbrirCatalogo"
                        style="-fx-background-color: #3182CE;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 9 18;"/>

                <Button
                        text="Cerrar sesión"
                        onAction="#onCerrarSesion"
                        style="-fx-background-color: #E53E3E;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 9 18;"/>

            </HBox>

            <!-- SEPARADOR -->

            <Separator opacity="0.4"/>

            <!-- INFORMACION DE SESION -->

            <HBox spacing="18"
                  alignment="CENTER_LEFT">

                <!-- USUARIO -->

                <VBox spacing="5"
                      HBox.hgrow="ALWAYS">

                    <Label
                            text="USUARIO AUTENTICADO"
                            textFill="#CBD5E0"
                            style="-fx-font-size: 11;
                               -fx-font-weight: bold;"/>

                    <Label
                            fx:id="lblUsuarioSesion"
                            text="Cargando usuario..."
                            textFill="WHITE"
                            style="-fx-font-size: 17;
                               -fx-font-weight: bold;"/>

                    <Label
                            fx:id="lblEmailSesion"
                            text="correo@ejemplo.com"
                            textFill="#BEE3F8"
                            style="-fx-font-size: 12;"/>

                </VBox>

                <!-- ROL -->

                <VBox spacing="5"
                      alignment="CENTER_LEFT"
                      style="-fx-background-color: #2A4365;
                             -fx-background-radius: 8;
                             -fx-padding: 12;">

                    <Label
                            text="ROL DEL USUARIO"
                            textFill="#CBD5E0"
                            style="-fx-font-size: 11;
                               -fx-font-weight: bold;"/>

                    <Label
                            fx:id="lblRolSesion"
                            text="Cargando..."
                            textFill="WHITE"
                            style="-fx-font-size: 15;
                               -fx-font-weight: bold;"/>

                </VBox>

                <!-- FARMACIA -->

                <VBox spacing="5"
                      alignment="CENTER_LEFT"
                      style="-fx-background-color: #2A4365;
                             -fx-background-radius: 8;
                             -fx-padding: 12;">

                    <Label
                            text="FARMACIA ASIGNADA"
                            textFill="#CBD5E0"
                            style="-fx-font-size: 11;
                               -fx-font-weight: bold;"/>

                    <Label
                            fx:id="lblFarmaciaSesion"
                            text="Cargando..."
                            textFill="WHITE"
                            style="-fx-font-size: 15;
                               -fx-font-weight: bold;"/>

                </VBox>

            </HBox>

            <Label
                    text="Gestión de inventario, trazabilidad y dispensación segura"
                    textFill="#CBD5E0"
                    style="-fx-font-size: 12;"/>

        </VBox>

    </top>

    <!-- ======================================= -->
    <!-- CONTENIDO PRINCIPAL                     -->
    <!-- ======================================= -->

    <center>

        <VBox spacing="14"
              style="-fx-background-color: #F7FAFC;">

            <padding>
                <Insets
                        top="18"
                        right="20"
                        bottom="18"
                        left="20"/>
            </padding>

            <!-- TITULO DE INVENTARIO -->

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <Label
                        text="Inventario de Lotes"
                        style="-fx-font-size: 18;
                           -fx-font-weight: bold;
                           -fx-text-fill: #1A365D;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="Actualizar tabla"
                        onAction="#onRefrescar"
                        style="-fx-background-color: #2B6CB0;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 9 16;"/>

            </HBox>

            <!-- ================================= -->
            <!-- INDICADORES                       -->
            <!-- ================================= -->

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <!-- TOTAL DE LOTES -->

                <VBox spacing="6"
                      prefWidth="220"
                      style="-fx-background-color: white;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 15;">

                    <Label
                            text="TOTAL DE LOTES"
                            style="-fx-text-fill: #718096;
                               -fx-font-size: 12;
                               -fx-font-weight: bold;"/>

                    <Label
                            fx:id="lblTotalLotes"
                            text="0"
                            style="-fx-text-fill: #2B6CB0;
                               -fx-font-size: 25;
                               -fx-font-weight: bold;"/>

                    <Button
                            text="Ver todos"
                            onAction="#onFiltrarTodos"/>

                </VBox>

                <!-- LOTES VENCIDOS -->

                <VBox spacing="6"
                      prefWidth="220"
                      style="-fx-background-color: white;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 15;">

                    <Label
                            text="LOTES VENCIDOS"
                            style="-fx-text-fill: #718096;
                               -fx-font-size: 12;
                               -fx-font-weight: bold;"/>

                    <Label
                            fx:id="lblLotesVencidos"
                            text="0"
                            style="-fx-text-fill: #C53030;
                               -fx-font-size: 25;
                               -fx-font-weight: bold;"/>

                    <Button
                            text="Ver vencidos"
                            onAction="#onFiltrarVencidos"/>

                </VBox>

                <!-- DISPONIBLES -->

                <VBox spacing="6"
                      prefWidth="220"
                      style="-fx-background-color: white;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 15;">

                    <Label
                            text="DISPENSACION"
                            style="-fx-text-fill: #718096;
                               -fx-font-size: 12;
                               -fx-font-weight: bold;"/>

                    <Label
                            text="Disponibles"
                            style="-fx-text-fill: #276749;
                               -fx-font-size: 18;
                               -fx-font-weight: bold;"/>

                    <Button
                            text="Ver aptos"
                            onAction="#onFiltrarDisponibles"/>

                </VBox>

            </HBox>

            <!-- ================================= -->
            <!-- BARRA DE BUSQUEDA                 -->
            <!-- ================================= -->

            <HBox spacing="12"
                  alignment="CENTER_LEFT">

                <TextField
                        fx:id="txtBuscar"
                        prefWidth="360"
                        promptText="Buscar por lote, medicamento o estado"
                        HBox.hgrow="ALWAYS"/>

                <Label
                        text="Categoría:"
                        style="-fx-font-weight: bold;
                           -fx-text-fill: #4A5568;"/>

                <ComboBox
                        fx:id="cmbCategoria"
                        prefWidth="200"
                        promptText="Seleccionar categoría"/>

            </HBox>

            <!-- ================================= -->
            <!-- TABLA PRINCIPAL                   -->
            <!-- ================================= -->

            <TableView
                    fx:id="tablaLotes"
                    VBox.vgrow="ALWAYS"
                    prefHeight="300">

                <columns>

                    <TableColumn
                            fx:id="colIdLote"
                            text="ID Lote"
                            prefWidth="80"/>

                    <TableColumn
                            fx:id="colNumeroLote"
                            text="Número de Lote"
                            prefWidth="160"/>

                    <TableColumn
                            fx:id="colIdMedicamento"
                            text="ID Medicamento"
                            prefWidth="140"/>

                    <TableColumn
                            fx:id="colCantidad"
                            text="Cantidad"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="colFechaVencimiento"
                            text="Fecha Vencimiento"
                            prefWidth="170"/>

                    <TableColumn
                            fx:id="colEstado"
                            text="Estado Sanitario"
                            prefWidth="170"/>

                </columns>

            </TableView>

        </VBox>

    </center>

    <!-- ======================================= -->
    <!-- MODULO DE DISPENSACION                  -->
    <!-- ======================================= -->

    <bottom>

        <VBox spacing="12"
              style="-fx-background-color: #EDF2F7;
                     -fx-border-color: #CBD5E0;
                     -fx-border-width: 1 0 0 0;
                     -fx-padding: 18;">

            <Label
                    text="Módulo de Dispensación"
                    style="-fx-font-size: 16;
                       -fx-font-weight: bold;
                       -fx-text-fill: #1A365D;"/>

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <!-- INFORMACION DEL LOTE -->

                <VBox spacing="5"
                      HBox.hgrow="ALWAYS">

                    <Label
                            text="Lote seleccionado"
                            style="-fx-text-fill: #718096;
                               -fx-font-size: 12;"/>

                    <Label
                            fx:id="lblLoteSeleccionadoInfo"
                            text="Ninguno (seleccione una fila)"
                            wrapText="true"
                            style="-fx-text-fill: #2D3748;
                               -fx-font-weight: bold;"/>

                </VBox>

                <!-- CANTIDAD -->

                <VBox spacing="5">

                    <Label
                            text="Cantidad a dispensar"
                            style="-fx-text-fill: #718096;
                               -fx-font-size: 12;"/>

                    <TextField
                            fx:id="txtCantidad"
                            prefWidth="120"
                            promptText="Ej: 2"/>

                </VBox>

                <!-- BOTON DE DISPENSACION -->

                <Button
                        text="Dispensar medicamento"
                        onAction="#onDispensar"
                        style="-fx-background-color: #2F855A;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 12 20;"/>

            </HBox>

        </VBox>

    </bottom>

</BorderPane>
