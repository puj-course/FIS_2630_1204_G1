@startuml

skinparam backgroundColor #F0F0F0
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
skinparam packageFontSize 14
skinparam packageFontStyle bold
hide circle

top to bottom direction

' ============================================================
' 1. APLICACION PRINCIPAL
' ============================================================
package "carestock" {

    class CareStockApp {
- {static} instance: CareStockApp

- primaryStage: Stage


        + {static} getInstance(): CareStockApp
        + start(stage: Stage): void
        + mostrarLogin(): void
        + mostrarDashboard(): void
        + mostrarCatalogo(): void
        + mostrarConsultaUnificada(): void
        + cerrarSesion(): void
        + {static} main(args: String[]): void
    }

    class Launcher <<arranque>> {
        + {static} main(args: String[]): void
    }

    class PruebaConexion <<utilidad>> {
        + {static} main(args: String[]): void
    }
}

' ============================================================
' 2. CONFIGURACION Y BASE DE DATOS
' ============================================================
package "config" {
    class ConexionBD {
- {static} pool: HikariDataSource

- ConexionBD()


        + {static} getConexion(): Connection
- {static} cargarConfiguracion(): Properties

- {static} crearPool(): HikariDataSource

        + {static} estadoPool(): String
        + {static} cerrarPool(): void
    }
}

' ============================================================
' 3. CONTROLADORES
' ============================================================
package "controller" {

    class LoginController {
- txtEmail: TextField

- txtPassword: PasswordField

- authService: AuthenticationService


        + LoginController()
        + initialize(): void
    }

    class InventarioController {
- tablaLotes: TableView<Lote>

- listaLotes: ObservableList<Lote>

- txtBuscar: TextField

- cmbCategoria: ComboBox<String>

- inventario: Inventario


        + InventarioController()
        + initialize(): void
    }

    class CatalogoController {
- tablaProductos: TableView<RegistroCatalogo>

- cmbCategoria: ComboBox<String>

- inventario: Inventario

- {static} FABRICA_ASEO: FabricaProducto<Aseo>

- {static} FABRICA_MATERNIDAD: FabricaProducto<Maternidad>

- {static} FABRICA_MEDICAMENTO: FabricaProducto<Medicamento>


        + initialize(): void
    }

    class ConsultaInventarioController {
- tablaInventario: TableView<ProductoInventario>

- productos: ObservableList<ProductoInventario>

- filtrados: FilteredList<ProductoInventario>

- sesionVista: DatosUsuario

- inventario: Inventario


        + initialize(): void
    }

    class "CatalogoController.CategoriaMedicamento" as CategoriaMedicamento <<record auxiliar>> {
        + id: int
        + nombre: String
    }
}

' ============================================================
' 4. SERVICIOS
' ============================================================
package "service" {

    class AuthenticationService {
- usuarioDAO: UsuarioDAO


        + AuthenticationService()
        + autenticar(email: String, password: String): Usuario
    }

    class RegistroLoteService {
        + registrarMedicamentoLote(lote: Lote, idUsuario: int, idFarmacia: int): Lote
    }

    class FarmacovigilanciaService {
        + dispensarMedicamento(idLote: int, cantidad: int): void
        + dispensarMedicamento(idLote: int, cantidad: int, idFarmacia: int, idUsuario: int): void
    }
}

' ============================================================
' 5. DAO
' ============================================================
package "dao" {

    interface LoteDAO {
        + guardar(lote: Lote): void
        + buscarPorId(idLote: int): Lote
        + listarPorMedicamento(idMedicamento: int): List<Lote>
        + listarPorFarmacia(idFarmacia: int): List<Lote>
        + listarTodos(): List<Lote>
        + actualizarCantidad(idLote: int, cantidad: int): void
        + actualizarEstado(idLote: int, estado: String): void
    }

    class LoteDAOImpl {
        + guardar(lote: Lote): void
        + buscarPorId(idLote: int): Lote
        + listarPorMedicamento(idMedicamento: int): List<Lote>
        + listarPorFarmacia(idFarmacia: int): List<Lote>
        + listarTodos(): List<Lote>
        + actualizarCantidad(idLote: int, cantidad: int): void
        + actualizarEstado(idLote: int, estado: String): void
    }

    interface MedicamentoDAO {
        + guardar(medicamento: Medicamento): void
        + buscarPorId(idMedicamento: int): Medicamento
        + buscarPorCodigoInvima(codigo: String): Medicamento
        + listarTodos(): List<Medicamento>
        + listarCategorias(): Map<Integer, String>
        + categoriaPorMedicamento(): Map<Integer, String>
        + actualizarEstado(id: int, estado: String): void
    }

    class MedicamentoDAOImpl {
        + guardar(medicamento: Medicamento): void
        + buscarPorId(idMedicamento: int): Medicamento
        + buscarPorCodigoInvima(codigo: String): Medicamento
        + listarTodos(): List<Medicamento>
        + listarCategorias(): Map<Integer, String>
        + categoriaPorMedicamento(): Map<Integer, String>
        + actualizarEstado(id: int, estado: String): void
    }

    interface UsuarioDAO {
        + buscarPorEmail(email: String): Usuario
    }

    class UsuarioDAOImpl {
        + buscarPorEmail(email: String): Usuario
    }

    class MedicamentoCatalogoDAO {
        + listarPorFarmacia(idFarmacia: int): List<Medicamento>
        + actualizar(id: int, producto: Medicamento, idFarmacia: int, idUsuario: int): boolean
        + desactivar(id: int, idFarmacia: int, idUsuario: int): boolean
        + {static} validarCampos(producto: Medicamento): void
    }

    abstract class "CatalogoDAO<T extends Validable>" as CatalogoDAO <<Template Method>> {
        # {abstract} tabla(): String
        # {abstract} columnaId(): String
        # {abstract} nombreProducto(): String
        # {abstract} columnasEspecificas(): List<String>
        # {abstract} asignarCampos(ps: PreparedStatement, producto: T): void
        # {abstract} construir(rs: ResultSet): RegistroCatalogo<T>

        + {final} guardar(producto: T, idFarmacia: int, idUsuario: int): int
        + {final} buscarPorId(id: int, idFarmacia: int): RegistroCatalogo<T>
        + {final} listarPorFarmacia(idFarmacia: int): List<RegistroCatalogo<T>>
        + {final} actualizar(id: int, producto: T, idFarmacia: int, idUsuario: int): boolean
        + {final} desactivar(id: int, idFarmacia: int, idUsuario: int): boolean
        # {final} asignarCamposComunes(ps: PreparedStatement, codigo: String, nombre: String, descripcion: String, precio: double, stock: int): void
        - mapear(rs: ResultSet): RegistroCatalogo<T>
    }

    class AseoDAO {
- {static} FABRICA: FabricaProducto<Aseo>

        + guardar(producto: Aseo, idFarmacia: int, idUsuario: int): int
        + buscarPorId(id: int, idFarmacia: int): RegistroCatalogo
        + listarPorFarmacia(idFarmacia: int): List<RegistroCatalogo>
        + actualizar(id: int, producto: Aseo, idFarmacia: int, idUsuario: int): boolean
        + desactivar(id: int, idFarmacia: int, idUsuario: int): boolean
    }

    class MaternidadDAO {
- {static} FABRICA: FabricaProducto<Maternidad>

        + guardar(producto: Maternidad, idFarmacia: int, idUsuario: int): int
        + buscarPorId(id: int, idFarmacia: int): RegistroCatalogo
        + listarPorFarmacia(idFarmacia: int): List<RegistroCatalogo>
        + actualizar(id: int, producto: Maternidad, idFarmacia: int, idUsuario: int): boolean
        + desactivar(id: int, idFarmacia: int, idUsuario: int): boolean
    }

    class ConsultaInventarioDAO <<RealSubject>> {
        + listarPorFarmacia(idFarmacia: int): List<ProductoInventario>
    }
}

' ============================================================
' 6. FACTORY METHOD
' ============================================================
package "factory" {

    abstract class "FabricaProducto<T extends Validable>" as FabricaProducto <<Factory Method>> {
        # {abstract} crearInstancia(): T
        + crear(configurar: Consumer<T>): T
    }

    class FabricaAseo <<ConcreteCreator>> {
        # crearInstancia(): Aseo
    }

    class FabricaMaternidad <<ConcreteCreator>> {
        # crearInstancia(): Maternidad
    }

    class FabricaMedicamento <<ConcreteCreator>> {
        # crearInstancia(): Medicamento
    }
}

' ============================================================
' 7. EXCEPCIONES
' ============================================================
package "exception" {
    class ReglaNegocioException <<Exception>> {
        + ReglaNegocioException(mensaje: String)
    }
}

' ============================================================
' 8. MODELO DE NEGOCIO
' ============================================================
