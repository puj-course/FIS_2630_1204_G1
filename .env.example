# Copie estos valores en variables de entorno locales. NO suba credenciales reales a Git.
DB_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require
DB_USER=usuario_postgresql
DB_PASSWORD=contraseña_postgresql

# Usuario de CareStock utilizado para la trazabilidad de movimientos mientras no exista login.
# Debe existir en USUARIOS y tener estado ACTIVO.
CARESTOCK_USER_EMAIL=admin@carestock.com

# Pool JDBC - rendimiento
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1
