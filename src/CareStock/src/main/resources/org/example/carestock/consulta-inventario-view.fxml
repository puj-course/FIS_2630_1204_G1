<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.carestock.controller.ConsultaInventarioController"
            prefWidth="1150" prefHeight="760"
            style="-fx-background-color: #FDFBF7;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: #A7D8D8; -fx-padding: 20;">

            <Label text="CareStock | Consulta unificada"
                   textFill="#20302F"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Volver al catalogo"
                    onAction="#onVolver"
                    style="-fx-background-color: rgba(32,48,47,0.08); -fx-text-fill: #20302F; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(32,48,47,0.25); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;"/>

            <Button text="Cerrar sesion"
                    onAction="#onCerrarSesion"
                    style="-fx-background-color: rgba(32,48,47,0.08); -fx-text-fill: #20302F; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(32,48,47,0.25); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 24;">

            <Label fx:id="lblFarmacia"
                   text="Farmacia"/>

            <HBox alignment="CENTER_LEFT" spacing="10">

                <ComboBox fx:id="cmbCategoria"
                          prefWidth="180"/>

                <TextField fx:id="txtBuscar"
                           promptText="Buscar por nombre o codigo"
                           HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnActualizar"
                        text="Actualizar datos"
                        onAction="#onActualizar"/>
            </HBox>

            <TableView fx:id="tablaInventario"
                       VBox.vgrow="ALWAYS"
                       prefHeight="450">
                <columns>
                    <TableColumn fx:id="colCodigo"
                                 text="Codigo" prefWidth="140"/>
                    <TableColumn fx:id="colNombre"
                                 text="Producto" prefWidth="250"/>
                    <TableColumn fx:id="colCategoria"
                                 text="Categoria" prefWidth="140"/>
                    <TableColumn fx:id="colPresentacion"
                                 text="Presentacion / unidad"
                                 prefWidth="185"/>
                    <TableColumn fx:id="colExistencia"
                                 text="Existencias" prefWidth="110"/>
                    <TableColumn fx:id="colEstado"
                                 text="Estado" prefWidth="110"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnRegistrar"
                        text="Registrar producto"
                        onAction="#onRegistrar"/>

                <Button fx:id="btnEditar"
                        text="Editar seleccionado"
                        onAction="#onEditar"/>
            </HBox>

            <HBox spacing="10">
                <Label fx:id="lblEstado"
                       text="Consultando..."
                       HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal"
                       text="Productos: --"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
