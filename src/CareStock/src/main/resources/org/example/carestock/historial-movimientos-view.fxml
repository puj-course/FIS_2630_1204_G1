<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.carestock.controller.ControladorHistorialMovimientos"
            prefWidth="1200"
            prefHeight="760"
            style="-fx-background-color: #FDFBF7; -fx-accent: #B7A6E0;">

    <top>
        <VBox spacing="12"
              style="-fx-background-color: #A7D8D8; -fx-padding: 20 28;">

            <HBox alignment="CENTER_LEFT" spacing="14">

                <VBox spacing="4">
                    <Label text="CareStock"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #20302F;"/>

                    <Label text="Historial unificado de movimientos"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2E4A48;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Volver al inventario"
                        onAction="#onVolver"
                        style="-fx-background-color: #EDE7F7; -fx-text-fill: #6B5B95; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 16;"/>

                <Button text="Cerrar sesion"
                        onAction="#onCerrarSesion"
                        style="-fx-background-color: #FDFBF7; -fx-text-fill: #20302F; -fx-background-radius: 8; -fx-padding: 10 16;"/>
            </HBox>

            <HBox spacing="22" alignment="CENTER_LEFT">

                <Label text="Usuario:"
                       style="-fx-font-weight: bold; -fx-text-fill: #20302F;"/>

                <Label fx:id="lblUsuario"
                       style="-fx-text-fill: #20302F;"/>

                <Label text="Farmacia:"
                       style="-fx-font-weight: bold; -fx-text-fill: #20302F;"/>

                <Label fx:id="lblFarmacia"
                       style="-fx-text-fill: #20302F;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="CONSULTA DE SOLO LECTURA"
                       style="-fx-text-fill: #6B5B95; -fx-font-size: 11; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16"
              style="-fx-background-color: #FDFBF7; -fx-padding: 24;">

            <VBox spacing="12"
                  style="-fx-background-color: WHITE; -fx-background-radius: 14; -fx-border-color: #E3D9F5; -fx-border-radius: 14; -fx-padding: 18;">

                <Label text="Filtros de busqueda"
                       style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #20302F;"/>

                <FlowPane hgap="14"
                          vgap="12"
                          prefWrapLength="1080">

                    <VBox spacing="6">
                        <Label text="Categoria"
                               style="-fx-font-weight: bold;"/>

                        <ComboBox fx:id="cmbCategoria"
                                  prefWidth="190"
                                  prefHeight="40"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Tipo de movimiento"
                               style="-fx-font-weight: bold;"/>

                        <ComboBox fx:id="cmbTipo"
                                  prefWidth="170"
                                  prefHeight="40"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Fecha desde"
                               style="-fx-font-weight: bold;"/>

                        <DatePicker fx:id="fechaDesde"
                                    promptText="Fecha inicial"
                                    prefWidth="165"
                                    prefHeight="40"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Fecha hasta"
                               style="-fx-font-weight: bold;"/>

                        <DatePicker fx:id="fechaHasta"
                                    promptText="Fecha final"
                                    prefWidth="165"
                                    prefHeight="40"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="12" alignment="CENTER_LEFT">

                    <Button fx:id="btnLimpiar"
                            text="Limpiar filtros"
                            onAction="#onLimpiarFiltros"
                            style="-fx-background-color: #EDE7F7; -fx-text-fill: #6B5B95; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 18;"/>

                    <Button fx:id="btnActualizar"
                            text="Actualizar historial"
                            onAction="#onActualizar"
                            style="-fx-background-color: #B7A6E0; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 18;"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="10">

                <Label text="Movimientos registrados"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #20302F;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Orden inicial: recientes primero"
                       style="-fx-text-fill: #6B5B95; -fx-font-size: 12;"/>
            </HBox>

            <TableView fx:id="tablaHistorial"
                       VBox.vgrow="ALWAYS"
                       prefHeight="420"
                       style="-fx-background-color: WHITE; -fx-background-radius: 10; -fx-border-color: #E3D9F5; -fx-border-radius: 10;">

                <columns>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha y hora"
                                 prefWidth="145"/>

                    <TableColumn fx:id="colProducto"
                                 text="Producto / referencia"
                                 prefWidth="260"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoria"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colTipo"
                                 text="Tipo"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colCantidad"
                                 text="Cantidad"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colUsuario"
                                 text="Usuario"
                                 prefWidth="135"/>

                    <TableColumn fx:id="colMotivo"
                                 text="Motivo / detalle"
                                 prefWidth="260"/>

                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT"
                  spacing="14"
                  style="-fx-background-color: #EDE7F7; -fx-background-radius: 10; -fx-padding: 13 16;">

                <Label fx:id="lblEstado"
                       text="Consultando movimientos..."
                       wrapText="true"
                       style="-fx-text-fill: #20302F;"
                       HBox.hgrow="ALWAYS"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblTotal"
                       text="Mostrando: 0"
                       style="-fx-font-weight: bold; -fx-text-fill: #6B5B95;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
