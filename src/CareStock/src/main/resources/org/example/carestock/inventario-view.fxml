<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.carestock.controller.InventarioController">
    <top>
        <VBox spacing="5.0" style="-fx-background-color: #1A365D; -fx-padding: 15;">
            <children>
                <Label text="CareStock - Control de Inventario y Farmacovigilancia" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Label text="Validación automatizada de normatividad INVIMA y dispensación segura" textFill="#CBD5E0">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Lotes Registrados en Neon DB">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnRefrescar" onAction="#onRefrescar" style="-fx-background-color: #2B6CB0;" text="🔄 Actualizar Tabla" textFill="WHITE" />
                    </children>
                </HBox>

                
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Total de lotes:" />
                    <Label fx:id="lblTotalLotes" text="0" />
                    <Label text="Vencidos:" />
                    <Label fx:id="lblLotesVencidos" text="0" />
                </HBox>

                <TextField fx:id="txtBuscar"
                           promptText="Buscar por lote, ID de medicamento o estado" />

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button text="Todos" onAction="#onFiltrarTodos" />
                    <Button text="Vencidos" onAction="#onFiltrarVencidos" />
                    <Button text="Aptos para dispensar" onAction="#onFiltrarDisponibles" />
                    <Label text="Categoría:" />
                    <ComboBox fx:id="cmbCategoria" prefWidth="180.0" />
                </HBox>

                <TableView fx:id="tablaLotes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdLote" prefWidth="75.0" text="ID Lote" />
                        <TableColumn fx:id="colNumeroLote" prefWidth="150.0" text="N° Lote" />
                        <TableColumn fx:id="colIdMedicamento" prefWidth="120.0" text="ID Medicamento" />
                        <TableColumn fx:id="colCantidad" prefWidth="110.0" text="Cantidad" />
                        <TableColumn fx:id="colFechaVencimiento" prefWidth="140.0" text="F. Vencimiento" />
                        <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado Sanitario" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10.0" style="-fx-background-color: #EDF2F7; -fx-padding: 15; -fx-border-color: #CBD5E0; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Módulo de Dispensación Sanitariamente Validada">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Lote seleccionado:" />
                        <Label fx:id="lblLoteSeleccionadoInfo" text="Ninguno (seleccione una fila)" wrapText="true" maxWidth="280.0" />

                        <Label text="Cantidad a Dispensar:" />
                        <TextField fx:id="txtCantidad" prefWidth="100.0" promptText="Ej: 2" />

                        <Button fx:id="btnDispensar" onAction="#onDispensar" style="-fx-background-color: #2F855A; -fx-font-weight: bold;" text="💊 Dispensar Medicamento" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>